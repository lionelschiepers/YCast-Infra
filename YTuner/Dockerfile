# exposed on NAS with port 20102
# test url: http://ls-nas:20102/setupapp/pioneer/asp/func/dynamOD.asp?ex45v=AC4C0837C5924A93A8A306CF6B1F96CF&id=101916

# Start with the Alpine 3.19 Docker image.
FROM alpine:latest AS builder

# Install libc6-compat, required for executables generated by FPC.
RUN apk --no-cache add libc6-compat wget unzip sqlite-libs

# Set working directory in the container image.
WORKDIR /build

RUN wget https://github.com/coffeegreg/YTuner/releases/download/1.2.6/ytuner-1.2.6-x86_64-linux.zip
RUN unzip -d . ytuner-1.2.6-x86_64-linux.zip 

FROM alpine:latest AS production

RUN apk --no-cache add libc6-compat sqlite-libs

WORKDIR /app

COPY --from=builder /build/ytuner-1.2.6-x86_64-linux /app

# ytuner ytuner.ini
RUN chmod +x ./ytuner
 
# Make the TCP/UDP ports to outside the container.
# EXPOSE 80/tcp
# EXPOSE 53/udp

# Run YTuner.
CMD ["./ytuner"]
