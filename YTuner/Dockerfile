# exposed on NAS with port 20102
# test url: http://ls-nas:20102/setupapp/pioneer/asp/func/dynamOD.asp?ex45v=AC4C0837C5924A93A8A306CF6B1F96CF&id=101916

ARG VERSION=1.2.6

FROM alpine:latest AS builder
ARG VERSION

# Install libc6-compat, required for executables generated by FPC.
RUN apk --no-cache add libc6-compat wget unzip sqlite-libs

# Set working directory in the container image.
WORKDIR /build

RUN wget https://github.com/coffeegreg/YTuner/releases/download/$VERSION/ytuner-$VERSION-x86_64-linux.zip
RUN unzip -d . ytuner-$VERSION-x86_64-linux.zip 

FROM alpine:latest AS production
ARG VERSION

RUN apk --no-cache add libc6-compat sqlite-libs curl

WORKDIR /app

COPY --from=builder /build/ytuner-$VERSION-x86_64-linux /app
# ytuner ytuner.ini
RUN chmod +x ./ytuner
 
# Make the TCP/UDP ports to outside the container.
EXPOSE 80/tcp
EXPOSE 53/udp

# Run YTuner.
HEALTHCHECK --interval=30s --timeout=10s --start-period=3m --retries=3 CMD curl -f http://localhost/ytuner/empty || exit 1
CMD ["./ytuner"]